{
  NSExecutable = NextBSD;
  NSPrincipalClass = NextBSD;
  GSThemeVersion = "0.1";
  GSThemeLicense = "BSD-2-Clause";
  GSThemeDetails = "The NextBSD dark desktop theme";
  GSThemeAuthors = ("Joseph Maloney 2026");
  GSThemeIcon = "NextBSD.png";
  /* Desktop defaults (see README): the user's choices in Workspace
     Preferences override these. */
  NBDockPosition = right;
  NBWindowMode = stacking;
  NBMenuStyle = nextstep;
  NBMinimizeStyle = dock;
  /* The Dock position and menu style for each window mode; switching
     mode applies its set (see README). */
  NBModeDefaults = {
    stacking = { NBDockPosition = right; NBMenuStyle = nextstep; };
    tiling = { NBDockPosition = bottom; NBMenuStyle = inwindow; };
  };
  GSThemeDomain = {
    NSFont = "Inter-Regular";
    NSBoldFont = "Inter-Bold";
    NSFontSize = 13;
    NSUserFont = "Inter-Regular";
    NSFixedPitchFont = "JetBrainsMono-Regular";
    NSUserFixedPitchFont = "JetBrainsMono-Regular";
    GSScrollerDefaultWidth = 14;
    GSScrollerArrowsSameEnd = YES;
  };
}
